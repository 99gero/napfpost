# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Geheim! Nur serverseitig (Netlify-Umgebungsvariable), nie im Browser. Wird nur für den Push-Versand genutzt.
SUPABASE_SECRET_KEY=sb_secret_...

# Web Push: einmalig erzeugen mit `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine@adresse.de

# Optional: feste Adresse für NFC-/QR-Links (z. B. https://app.meinedomain.de). Leer = aktuelle Adresse.
NEXT_PUBLIC_APP_URL=
